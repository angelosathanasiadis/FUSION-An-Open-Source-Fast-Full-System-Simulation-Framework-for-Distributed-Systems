package HLANode;

simple Txc0
{
	parameters:
		double RXPacketTime = default(0.000012);
		double StartRXPacketTime = default(0);
		int nodeNo = default(0);
		bool sendInitialMessage = default(false);

		@display("i=block/routing");
	gates:
		inout gate;
}
simple Txc1 extends Txc0
{
		parameters:    
		RXPacketTime = default(0.000012);
		StartRXPacketTime = default(0);
		nodeNo = default(1);

		sendInitialMessage = default(false);
		@display("i=block/routing");
}



simple SyncNode
{
	parameters:
		int NumberOfHLANodes = default(2);
		double SynchTime = default(0.000012);
		double StartSynchTime = default(0);

		bool sendInitialMessage = default(false);
		@display("i=block/routing");
	gates:
		input in;
		output out;
}
